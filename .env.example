# Copy to .env.local and fill in the values you need.
# The app builds without these; AI and database features require them at runtime.

# Postgres (Neon or any Postgres-compatible URL)
DATABASE_URL=postgres://user:password@host:5432/database

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1
# Optional: label the model build used in generated insight rows
OPENAI_MODEL_VERSION=

# Optional: minimum milliseconds between LLM calls in a run
INSIGHT_LLM_MIN_INTERVAL_MS=30000
MANAGER_ANALYSIS_LLM_MIN_INTERVAL_MS=30000

# Optional: GitHub ingestion
GITHUB_TOKEN=
GITHUB_ORG=

# Optional: Slack delivery and ingestion
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_WEBHOOK_URL=
